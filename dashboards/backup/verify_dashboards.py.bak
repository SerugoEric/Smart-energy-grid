"""Section 7.3: verify Raw and Aggregate dashboards return matching results.

EXPORT and COMPARISON
    Both modes are run for the Section 7.3 range:
        00:00 on 22 September through 00:00 on 29 September (exclusive),
        all regions including the selected meter panel for meter 1000000000.
    The numerical data behind every panel is written to CSV:
        dashboards/panel_data_raw.csv   and   dashboards/panel_data_agg.csv
    Then each panel's rows are matched by key (bucket + region / bucket /
    period / meter) and compared with the requirements:
        identical keys and reading counts
        energy differences no greater than 0.001 kWh
        completeness differences no greater than 0.000001 percentage points

    P5 uses two comparison views: observed counts (must match exactly) and
    completeness percentages (small-tolerance comparison).

HOW TO RUN
    From the project root:

        python dashboards\\verify_dashboards.py
"""

import csv
import sys
from datetime import datetime
from pathlib import Path

PROJECT_ROOT = str(Path(__file__).resolve().parent.parent)
sys.path.insert(0, PROJECT_ROOT)

from common.cat_time import cat_now, cat_text  # noqa: E402
from common.db import machine_identifier  # noqa: E402
from common.logging_utils import run_with_log  # noqa: E402
from dashboard_data import PANELS, run_raw, run_agg  # noqa: E402

START = datetime.fromisoformat("2026-09-22T00:00:00+02:00")
END = datetime.fromisoformat("2026-09-29T00:00:00+02:00")
METER = 1000000000

ENERGY_TOLERANCE = 0.001
COMPLETENESS_TOLERANCE = 0.000001


def write_csv(path: Path, rename: dict, rows) -> None:
    if not rows:
        return
    fieldnames = sorted({k for r in rows for k in r.keys()})
    with open(path, "w", newline="", encoding="utf-8") as out:
        writer = csv.DictWriter(out, fieldnames=fieldnames,
                                extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)


def remember(rows, panel_id, mode):
    for r in rows:
        r["panel"] = panel_id
        r["mode"] = mode
    return rows


def main() -> None:
    started = cat_now()
    print("=" * 78)
    print("Section 7.3  Verify Raw and Aggregate match")
    print(f"Started {cat_text()} CAT")
    print(f"Machine {machine_identifier()}")
    print("=" * 78)
    print(f"Range {START} .. {END} exclusive, all regions, meter {METER}")
    print("")

    raw = run_raw(START, END, METER)
    agg = run_agg(START, END, METER)

    all_raw, all_agg = [], []
    for panel_id in PANELS:
        all_raw += remember(raw[panel_id].rows, panel_id, "Raw")
        all_agg += remember(agg[panel_id].rows, panel_id, "Aggregate")
    write_csv(Path(PROJECT_ROOT) / "dashboards" / "panel_data_raw.csv", None,
              all_raw)
    write_csv(Path(PROJECT_ROOT) / "dashboards" / "panel_data_agg.csv", None,
              all_agg)
    print("Panel data exported to panel_data_raw.csv / panel_data_agg.csv")
    print("")

    panel_keys = {
        "P1": ("bucket", "region"),
        "P2": ("bucket",),
        "P3": ("period",),
        "P4": ("bucket",),
    }
    print(f"{'Panel':<6}{'Rows':>10}{'Energy max abs diff':>22}"
          f"{'Counts equal':>14}")
    print("  " + "-" * 56)
    overall_ok = True
    for panel_id in PANELS:
        left = raw[panel_id].rows
        right = agg[panel_id].rows
        if len(left) != len(right):
            print(f"  {panel_id:<6}{len(left):>10}{'ROW COUNT MISMATCH':>22}"
                  f"  Raw {len(left)} vs Agg {len(right)}")
            overall_ok = False
            continue
        if panel_id == "P5":
            max_diff = 0.0
            counts_ok = True
            by_region = {}
            for r in left:
                by_region[r["region"]] = r
            for r in right:
                ref = by_region.get(r["region"])
                if ref is None:
                    counts_ok = False
                    continue
                max_diff = max(max_diff,
                               abs(ref["completeness"] - r["completeness"]))
                if ref["observed"] != r["observed"]:
                    counts_ok = False
            ok = max_diff <= COMPLETENESS_TOLERANCE and counts_ok
            overall_ok = overall_ok and ok
            print(f"  {panel_id:<6}{len(left):>10}{max_diff:>22.9f}"
                  f"{str(counts_ok):>14}")
            for r in left:
                r["completeness"] = round(r["completeness"], 9)
            for r in right:
                r["completeness"] = round(r["completeness"], 9)
            if not counts_ok:
                print("    ! observed counts differ between modes")
            if not ok:
                print("    ! completeness beyond 0.000001 percentage points")
            continue

        keys = panel_keys[panel_id]
        by_key = {}
        for r in left:
            by_key[tuple(r[k] for k in keys)] = r
        max_diff = 0.0
        counts = True  # P3/P4/P2 have no separate counts; key equality holds
        mismatch = False
        for r in right:
            ref = by_key.get(tuple(r[k] for k in keys))
            if ref is None:
                mismatch = True
                continue
            max_diff = max(max_diff, abs(ref["energy_kwh"] - r["energy_kwh"]))
            if "observed" in ref and "observed" in r:
                counts = counts and ref["observed"] == r["observed"]
        ok = max_diff <= ENERGY_TOLERANCE and not mismatch and counts
        overall_ok = overall_ok and ok
        print(f"  {panel_id:<6}{len(left):>10}{max_diff:>22.6f}"
              f"{str(counts and not mismatch):>14}")
        if mismatch:
            print("    ! key mismatch (unmatched rows)")
        if not ok:
            print("    ! energy beyond 0.001 kWh")
    print("")
    print("PASS - both dashboards match within tolerances" if overall_ok
          else "FAIL - differences found, investigate before timing")
    print(f"Completed {cat_text()} CAT")
    print(f"Duration {(cat_now() - started).total_seconds():.3f} s")


if __name__ == "__main__":
    run_with_log("verify_dashboards", main)