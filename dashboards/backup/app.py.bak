"""Dash dashboard application (Sections 7.1 and 7.2).

The application serves one dashboard with two measurement modes, selected by
the mode radio:
    Raw       all five panels issue SQL directly against energy_readings
              (and meters) as in Section 7.1.
    Aggregate all five panels read the Section 6.1 continuous aggregates
              (cagg_hour_region, cagg_15min_region, cagg_day_meter), summing
              stored sums/reading counts where buckets are combined, and use
              meters only for labels and registered counts (Section 7.2).

The five panels are:
    P1 hourly regional energy
    P2 daily network energy
    P3 network energy in the four Section 5.1 seven-day periods
    P4 daily energy of the selected meter
    P5 completeness by region (Section 5.3)

The date inputs accept whole CAT days (YYYY-MM-DD) and are converted to
exclusive-end CAT ranges [date 00:00+02, date+1 00:00+02). The refresh button
re-runs all five panel queries; on first load the page refreshes itself once
through a one-shot interval. No result caching is performed, so every refresh
executes every panel query (Section 7.4 measures those executions).

HOW TO RUN
    From the project root:

        python dashboards\\app.py

    then open http://127.0.0.1:8050 in a browser.
"""

import json
import os
import sys
from datetime import datetime, timedelta
from pathlib import Path

import plotly.graph_objects as go
from dash import Dash, Input, Output, State, dcc, html

PROJECT_ROOT = str(Path(__file__).resolve().parent.parent)
sys.path.insert(0, PROJECT_ROOT)

from common.cat_time import cat_now, cat_text  # noqa: E402
from dashboard_data import PANELS, run_dashboard  # noqa: E402

INITIAL_START = datetime.fromisoformat("2026-09-22T00:00:00+02:00")
INITIAL_END = datetime.fromisoformat("2026-09-29T00:00:00+02:00")
INITIAL_METER = 1000000000

# Three panels per row at a fixed height, so all five panels fit on one
# 1920x1080 screen together with the filters and the taskbar. Section 7.1 and
# 7.2 ask for a screenshot of the running dashboard with every panel visible.
PANEL_STYLE = {"width": "33%", "height": "280px", "padding": "4px",
               "border": "1px solid #d0d0d0", "boxSizing": "border-box"}
PANEL_HEIGHT = 280
PANEL_MARGIN = dict(l=55, r=15, t=40, b=35)


def hour_x(values):
    return [v.isoformat(timespec="minutes") for v in values]


def figure_p1(rows) -> dict:
    regions = sorted({r["region"] for r in rows})
    buckets = sorted({r["bucket"] for r in rows})
    fig = go.Figure()
    for region in regions:
        fig.add_trace(go.Scatter(
            x=hour_x([b for b in buckets]),
            y=[next((r["energy_kwh"] for r in rows
                     if r["region"] == region and r["bucket"] == b), None)
               for b in buckets],
            mode="lines",
            name=region,
            connectgaps=False,
        ))
    fig.update_layout(title="P1  Hourly regional energy (kWh)",
                      xaxis_title="CAT hour",
                      yaxis_title="Energy [kWh]",
                      height=PANEL_HEIGHT,
                      margin=dict(l=55, r=15, t=70, b=35),
                      legend=dict(orientation="h", x=0, y=1.16,
                                  font=dict(size=9)))
    return fig


def figure_p2(rows) -> dict:
    fig = go.Figure(go.Bar(
        x=hour_x([r["bucket"] for r in rows]),
        y=[r["energy_kwh"] for r in rows],
    ))
    fig.update_layout(title="P2  Daily network energy (kWh)",
                      xaxis_title="CAT day",
                      yaxis_title="Energy [kWh]",
                      height=PANEL_HEIGHT, margin=PANEL_MARGIN)
    return fig


def figure_p3(rows) -> dict:
    fig = go.Figure(go.Bar(
        x=[r["period"] for r in rows],
        y=[r["energy_kwh"] for r in rows],
    ))
    fig.update_layout(title="P3  Network energy in Section 5.1 seven-day "
                            "periods (kWh)",
                      xaxis_title="Seven-day period",
                      yaxis_title="Energy [kWh]",
                      height=PANEL_HEIGHT, margin=PANEL_MARGIN)
    return fig


def figure_p4(rows) -> dict:
    fig = go.Figure(go.Bar(
        x=hour_x([r["bucket"] for r in rows]),
        y=[r["energy_kwh"] for r in rows],
    ))
    fig.update_layout(title="P4  Daily energy of selected meter (kWh)",
                      xaxis_title="CAT day",
                      yaxis_title="Energy [kWh]",
                      height=PANEL_HEIGHT, margin=PANEL_MARGIN)
    return fig


def figure_p5(rows, meter_label: str) -> dict:
    fig = go.Figure(go.Bar(
        x=[r["region"] for r in rows],
        y=[r["completeness"] for r in rows],
    ))
    fig.update_layout(title=f"P5  Completeness by region ({meter_label})",
                      xaxis_title="Region",
                      yaxis_title="Completeness [%]",
                      height=PANEL_HEIGHT, margin=PANEL_MARGIN)
    return fig


FIGURE_DEFS = {
    "P1": figure_p1,
    "P2": figure_p2,
    "P3": figure_p3,
    "P4": figure_p4,
}


def build(mode: str, start, end, meter_id) -> tuple[dict, dict]:
    """Run the five panel queries and build their figures.

    Returns (figures, timings). Every panel figure and query is produced
    identically to what a browser refresh reports; this function is also used
    by the timing harness so the measured work matches the dashboard work.
    """
    started = cat_now()
    results = run_dashboard(mode, start, end, meter_id)
    figures = {}
    timings = {}
    for panel_id in PANELS:
        panel = results[panel_id]
        timings[panel_id] = round(panel.query_ms, 3)
        if panel_id == "P5":
            figures[panel_id] = figure_p5(
                panel.rows, f"{mode} mode, meter {meter_id}")
        else:
            figures[panel_id] = FIGURE_DEFS[panel_id](panel.rows)
    timings["total_ms"] = round(
        sum(results[p].query_ms for p in PANELS), 3)
    timings["started"] = started.isoformat(timespec="seconds")
    timings["finished"] = cat_now().isoformat(timespec="seconds")
    timings["mode"] = mode
    return figures, timings


def load_meters():
    from common.db import connect

    connection = connect()
    with connection.cursor() as cursor:
        cursor.execute("SELECT meter_id FROM meters ORDER BY meter_id")
        options = [row[0] for row in cursor.fetchall()]
    connection.close()
    return [
        {"label": str(m), "value": m}
        for m in options[:50]
    ] + [{"label": "1000000000 (Section 7.3 default)", "value": 1000000000}]


app = Dash(__name__)
METER_OPTIONS = load_meters()

app.layout = html.Div(children=[
    html.H1("Smart Energy Grid Dashboard", style={"textAlign": "center"}),
    html.Div([
        html.Span("Mode: "),
        dcc.RadioItems(
            id="mode",
            options=[{"label": "Raw", "value": "Raw"},
                     {"label": "Aggregate", "value": "Aggregate"}],
            value=os.environ.get("DASH_MODE", "Raw"),
            inline=True, style={"marginRight": "40px"},
        ),
        html.Span("Start (CAT day): ", style={"marginLeft": "20px"}),
        dcc.Input(id="start", type="text",
                  value=INITIAL_START.strftime("%Y-%m-%d")),
        html.Span("End (CAT day, exclusive): ", style={"marginLeft": "20px"}),
        dcc.Input(id="end", type="text",
                  value=INITIAL_END.strftime("%Y-%m-%d")),
        html.Span("Meter: ", style={"marginLeft": "20px"}),
        dcc.Dropdown(id="meter", options=METER_OPTIONS,
                     value=INITIAL_METER,
                     style={"width": 260, "display": "inline-block"}),
        html.Button("Refresh", id="refresh", n_clicks=0,
                    style={"marginLeft": "20px"}),
    ], style={"margin": "10px auto", "width": "95%",
              "display": "flex", "alignItems": "center"}),
    html.Div(id="timings", style={"margin": "10px auto", "width": "95%",
                                  "fontFamily": "monospace",
                                  "whiteSpace": "pre-wrap"}),
    html.Div([
        dcc.Graph(id="g1", figure={}, style=PANEL_STYLE),
        dcc.Graph(id="g2", figure={}, style=PANEL_STYLE),
        dcc.Graph(id="g3", figure={}, style=PANEL_STYLE),
        dcc.Graph(id="g4", figure={}, style=PANEL_STYLE),
        dcc.Graph(id="g5", figure={}, style=PANEL_STYLE),
    ], style={"display": "flex", "flexWrap": "wrap", "width": "96%",
              "margin": "0 auto", "alignItems": "flex-start"}),
    # Fire the first refresh automatically once.
    dcc.Interval(id="firstload", interval=100, max_intervals=1),
])


@app.callback(
    [Output("g1", "figure"), Output("g2", "figure"), Output("g3", "figure"),
     Output("g4", "figure"), Output("g5", "figure"),
     Output("timings", "children")],
    [Input("refresh", "n_clicks"), Input("firstload", "n_intervals")],
    [State("mode", "value"), State("start", "value"), State("end", "value"),
     State("meter", "value")],
)
def refresh_dashboard(_clicks, _first, mode, start, end, meter):
    start_dt = datetime.fromisoformat(f"{start}T00:00:00+02:00")
    end_dt = datetime.fromisoformat(f"{end}T00:00:00+02:00")
    figures, timings = build(mode, start_dt, end_dt, int(meter))
    summary = (f"Dashboard: {mode}   range {start} .. {end}   "
               f"meter {meter}\n" +
               "\n".join(f"  {k:<6}{v:>12.3f} ms"
                         for k, v in timings.items() if k != "started"
                         and k != "finished" and k != "mode") +
               f"\n  span   {timings['started']} .. {timings['finished']}")
    return (figures["P1"], figures["P2"], figures["P3"],
            figures["P4"], figures["P5"], summary)


if __name__ == "__main__":
    print(f"Starting dashboard server {cat_text()} CAT")
    app.run(debug=False, host="127.0.0.1",
            port=int(os.environ.get("DASH_PORT", "8050")))
