"""Shared data layer for the Raw and Aggregate dashboards (Sections 7.1-7.4).

EVERY panel appears in two flavours:
    run_raw(...)   queries energy_readings directly (join meters where needed)
    run_agg(...)   queries the Section 6.1 continuous aggregates (cagg_hour_region,
                   cagg_15min_region, cagg_day_meter); meters is read only for
                   labels and registered counts

Each flavour executes one SQL statement per panel, times the statement with
time.perf_counter, and returns the result rows as Python records together with
the query duration in milliseconds. Figure objects are built by the caller so
the timing harness can time the query separately from rendering.

The five panels follow Section 7.1.2:
    P1 hourly regional energy          (kWh, per CAT hour per region)
    P2 daily network energy            (kWh, per CAT day)
    P3 network energy in the four seven-day periods of Section 5.1
    P4 daily energy of the selected meter
    P5 completeness by region           (percent, Section 5.3)

Both flavours filter event_time to [start, end) which are exclusive-end CAT
buckets, and limit P4 to the selected meter. Completeness planned counts come
from the meters table and the number of calendar days in the range.

The dashboard functions are also what the timing harness in
time_dashboards.py drives, so the measured per-panel SQL is byte-for-byte the
SQL the dashboard panels issue.
"""

import sys
import time
from pathlib import Path

PROJECT_ROOT = str(Path(__file__).resolve().parent.parent)
sys.path.insert(0, PROJECT_ROOT)

from common.db import connect  # noqa: E402

ORIGIN = "2026-09-01 00:00:00+02"

# The four seven-day periods of Section 5.1, aligned to CAT midnight.
SEVEN_DAY_PERIODS = [
    ("1-7 Sep",   "2026-09-01 00:00:00+02", "2026-09-08 00:00:00+02"),
    ("8-14 Sep",  "2026-09-08 00:00:00+02", "2026-09-15 00:00:00+02"),
    ("15-21 Sep", "2026-09-15 00:00:00+02", "2026-09-22 00:00:00+02"),
    ("22-28 Sep", "2026-09-22 00:00:00+02", "2026-09-29 00:00:00+02"),
]

PANELS = ["P1", "P2", "P3", "P4", "P5"]


class Panel:
    def __init__(self, panel_id: str, query_ms: float, rows) -> None:
        self.panel_id = panel_id
        self.query_ms = query_ms
        self.rows = rows


def _meters_lookup(cursor):
    cursor.execute(
        "SELECT meter_id, region, customer_type FROM meters ORDER BY meter_id"
    )
    return [dict(row) for row in cursor.fetchall()]


def _region_register() -> list:
    connection = connect()
    with connection.cursor() as cursor:
        cursor.execute(
            """
            SELECT region, count(*) AS registered
            FROM meters GROUP BY region
            ORDER BY split_part(region, ' ', 2)::int
            """
        )
        regions = [{"region": row[0], "registered": row[1]}
                   for row in cursor.fetchall()]
    connection.close()
    return regions


# ----------------------------------------------------------------------
# Raw flavour
# ----------------------------------------------------------------------
def run_raw(start, end, meter_id) -> dict:
    connection = connect()
    cursor = connection.cursor()
    results = {}

    started = time.perf_counter()
    cursor.execute(
        """
        SELECT time_bucket(INTERVAL '1 hour', r.event_time,
                           TIMESTAMPTZ %s) AS bucket,
               m.region AS region,
               sum(r.energy_kwh) AS energy_kwh
        FROM energy_readings r
        JOIN meters m USING (meter_id)
        WHERE r.event_time >= %s::timestamptz AND r.event_time < %s::timestamptz
        GROUP BY bucket, m.region
        ORDER BY bucket, m.region
        """,
        (ORIGIN, start, end),
    )
    results["P1"] = Panel(
        "P1", (time.perf_counter() - started) * 1000.0,
        [dict(bucket=r[0], region=r[1], energy_kwh=float(r[2]))
         for r in cursor.fetchall()],
    )

    started = time.perf_counter()
    cursor.execute(
        """
        SELECT time_bucket(INTERVAL '1 day', r.event_time,
                           TIMESTAMPTZ %s) AS bucket,
               sum(r.energy_kwh) AS energy_kwh
        FROM energy_readings r
        WHERE r.event_time >= %s::timestamptz AND r.event_time < %s::timestamptz
        GROUP BY bucket
        ORDER BY bucket
        """,
        (ORIGIN, start, end),
    )
    results["P2"] = Panel(
        "P2", (time.perf_counter() - started) * 1000.0,
        [dict(bucket=r[0], energy_kwh=float(r[1]))
         for r in cursor.fetchall()],
    )

    started = time.perf_counter()
    rows = []
    for label, p_start, p_end in SEVEN_DAY_PERIODS:
        cursor.execute(
            """
            SELECT sum(r.energy_kwh) AS energy_kwh
            FROM energy_readings r
            WHERE r.event_time >= GREATEST(%s::timestamptz, %s::timestamptz)
              AND r.event_time < LEAST(%s::timestamptz, %s::timestamptz)
            """,
            (p_start, start, p_end, end),
        )
        value = cursor.fetchone()[0]
        if value is not None:
            rows.append({"period": label, "energy_kwh": float(value)})
    results["P3"] = Panel(
        "P3", (time.perf_counter() - started) * 1000.0, rows,
    )

    started = time.perf_counter()
    cursor.execute(
        """
        SELECT time_bucket(INTERVAL '1 day', r.event_time,
                           TIMESTAMPTZ %s) AS bucket,
               sum(r.energy_kwh) AS energy_kwh
        FROM energy_readings r
        WHERE r.meter_id = %s
          AND r.event_time >= %s::timestamptz AND r.event_time < %s::timestamptz
        GROUP BY bucket
        ORDER BY bucket
        """,
        (ORIGIN, meter_id, start, end),
    )
    results["P4"] = Panel(
        "P4", (time.perf_counter() - started) * 1000.0,
        [dict(bucket=r[0], energy_kwh=float(r[1]))
         for r in cursor.fetchall()],
    )

    # P5 completeness by region: observed unique pairs over planned readings.
    days = (end - start).days
    started = time.perf_counter()
    cursor.execute(
        """
        SELECT m.region,
               count(DISTINCT (r.meter_id, r.event_time)) AS observed
        FROM energy_readings r
        JOIN meters m USING (meter_id)
        WHERE r.event_time >= %s::timestamptz AND r.event_time < %s::timestamptz
        GROUP BY m.region
        ORDER BY split_part(m.region, ' ', 2)::int
        """,
        (start, end),
    )
    observed_by_region = {row[0]: row[1] for row in cursor.fetchall()}
    row_list = []
    for region, registered in [(x["region"], x["registered"])
                               for x in _region_register()]:
        planned = registered * 96 * days
        observed = observed_by_region[region]
        row_list.append({
            "region": region,
            "registered": registered,
            "observed": observed,
            "planned": planned,
            "completeness": 100.0 * observed / planned,
        })
    results["P5"] = Panel(
        "P5", (time.perf_counter() - started) * 1000.0, row_list,
    )

    cursor.close()
    connection.close()
    return results


# ----------------------------------------------------------------------
# Aggregate flavour
# ----------------------------------------------------------------------
def run_agg(start, end, meter_id) -> dict:
    connection = connect()
    cursor = connection.cursor()
    results = {}

    started = time.perf_counter()
    cursor.execute(
        """
        SELECT bucket, region, sum(sum_energy_kwh) AS energy_kwh
        FROM cagg_hour_region
        WHERE bucket >= %s::timestamptz AND bucket < %s::timestamptz
        GROUP BY bucket, region
        ORDER BY bucket, region
        """,
        (start, end),
    )
    results["P1"] = Panel(
        "P1", (time.perf_counter() - started) * 1000.0,
        [dict(bucket=r[0], region=r[1], energy_kwh=float(r[2]))
         for r in cursor.fetchall()],
    )

    started = time.perf_counter()
    cursor.execute(
        """
        SELECT time_bucket(INTERVAL '1 day', bucket,
                           TIMESTAMPTZ %s) AS bucket,
               sum(sum_energy_kwh) AS energy_kwh
        FROM cagg_15min_region
        WHERE bucket >= %s::timestamptz AND bucket < %s::timestamptz
        GROUP BY 1
        ORDER BY 1
        """,
        (ORIGIN, start, end),
    )
    results["P2"] = Panel(
        "P2", (time.perf_counter() - started) * 1000.0,
        [dict(bucket=r[0], energy_kwh=float(r[1]))
         for r in cursor.fetchall()],
    )

    started = time.perf_counter()
    rows = []
    for label, p_start, p_end in SEVEN_DAY_PERIODS:
        cursor.execute(
            """
            SELECT sum(sum_energy_kwh) AS energy_kwh
            FROM cagg_15min_region
            WHERE bucket >= GREATEST(%s::timestamptz, %s::timestamptz)
              AND bucket < LEAST(%s::timestamptz, %s::timestamptz)
            """,
            (p_start, start, p_end, end),
        )
        value = cursor.fetchone()[0]
        if value is not None:
            rows.append({"period": label, "energy_kwh": float(value)})
    results["P3"] = Panel(
        "P3", (time.perf_counter() - started) * 1000.0, rows,
    )

    started = time.perf_counter()
    cursor.execute(
        """
        SELECT bucket, sum_energy_kwh AS energy_kwh
        FROM cagg_day_meter
        WHERE meter_id = %s
          AND bucket >= %s::timestamptz AND bucket < %s::timestamptz
        ORDER BY bucket
        """,
        (meter_id, start, end),
    )
    results["P4"] = Panel(
        "P4", (time.perf_counter() - started) * 1000.0,
        [dict(bucket=r[0], energy_kwh=float(r[1]))
         for r in cursor.fetchall()],
    )

    days = (end - start).days
    started = time.perf_counter()
    cursor.execute(
        """
        SELECT region, sum(reading_count) AS observed
        FROM cagg_15min_region
        WHERE bucket >= %s::timestamptz AND bucket < %s::timestamptz
        GROUP BY region
        ORDER BY split_part(region, ' ', 2)::int
        """,
        (start, end),
    )
    observed_by_region = {row[0]: int(row[1]) for row in cursor.fetchall()}
    row_list = []
    for region, registered in [(x["region"], x["registered"])
                               for x in _region_register()]:
        planned = registered * 96 * days
        observed = observed_by_region[region]
        row_list.append({
            "region": region,
            "registered": registered,
            "observed": observed,
            "planned": planned,
            "completeness": 100.0 * observed / planned,
        })
    results["P5"] = Panel(
        "P5", (time.perf_counter() - started) * 1000.0, row_list,
    )

    cursor.close()
    connection.close()
    return results


def run_dashboard(mode: str, start, end, meter_id) -> dict:
    """Dispatch to the requested flavour; returns {panel_id: Panel}."""
    from datetime import datetime

    if isinstance(start, str):
        start = datetime.fromisoformat(start)
    if isinstance(end, str):
        end = datetime.fromisoformat(end)
    return run_raw(start, end, meter_id) if mode == "Raw" \
        else run_agg(start, end, meter_id)